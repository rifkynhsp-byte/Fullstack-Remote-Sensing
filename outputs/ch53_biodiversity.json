  "kind": "chart",
  "caption": "Percent change in all forest and in core forest.",
  "image": "images/real/ch53-change.png",
  "live": "import io\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nDATA = \"\"\"where,forest_2000_ha,forest_2023_ha,forest_change,core_2000_ha,core_2023_ha,core_change\noutside the park,3.294e+05,2.8885e+05,-0.1231,84729,18911,-0.7768\ninside the park,2.0065e+05,1.9466e+05,-0.029845,1.5251e+05,1.2214e+05,-0.19916\n\"\"\"\ndf = pd.read_csv(io.StringIO(DATA))\n\ndef plot_change(df):\n    fig, ax = plt.subplots(figsize=(6.8, 3.4))\n    x = np.arange(len(df))\n    ax.bar(x - 0.18, df.forest_change * 100, 0.36, color=\"#41ab5d\", label=\"all forest\")\n    ax.bar(x + 0.18, df.core_change * 100, 0.36, color=\"#00441b\", label=f\"core (> {EDGE_M} m from edge)\")\n    ax.set_xticks(x, df[\"where\"])\n    ax.axhline(0, color=\"#1f2933\", lw=0.8)\n    ax.set_ylabel(\"Change 2000-2023 (%)\")\n    ax.set_title(\"Core forest is lost faster than forest\", loc=\"left\", fontsize=10)\n    ax.legend(frameon=False, fontsize=8)\n    return fig\n\nplot_change(df)\nplt.show()\n"
