  "caption": "T4. Correlation of Landsat 8 NDVI with field AGB at the CIFOR West Papua plots, for each year's composite. Without survey dates the 'right' year is unknown.",
  "image": "images/real/t04-years.png",
  "live": "import io\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nDATA = \"\"\"year,plots_with_data,r_ndvi_agb\n2013,45,0.22963\n2014,45,0.20234\n2015,45,0.22191\n2016,45,0.2638\n2017,45,0.24007\n2018,45,0.14565\n2019,45,0.18379\n2020,45,0.19349\n2021,45,0.074876\n2022,45,0.20539\n2023,45,0.051838\n\"\"\"\ndf = pd.read_csv(io.StringIO(DATA))\n\ndef plot_years(df):\n    fig, ax = plt.subplots(figsize=(6.6, 3.2))\n    ax.plot(df.year, df.r_ndvi_agb, \"o-\", color=\"#2a78d6\")\n    ax.axhline(0, color=\"#9aa5b1\", lw=0.8)\n    ax.set_xlabel(\"Year of the Landsat NDVI composite\")\n    ax.set_ylabel(\"Correlation with plot AGB (r)\")\n    ax.set_title(\"T4: the same plots, a different answer every year\", loc=\"left\",\n                 fontsize=10)\n    return fig\n\nplot_years(df)\nplt.show()\n"
 },
