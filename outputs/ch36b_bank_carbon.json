 {
  "name": "t01-learning",
  "kind": "chart",
  "caption": "T1. Random Forest on 2021 embeddings, trained with n WorldCover labels per class near Bandung and tested on 750 labels near Garut. WorldCover is itself a map, so this measures agreement, not truth.",
  "image": "images/real/t01-learning.png",
  "live": "import io\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nDATA = \"\"\"labels_per_class,seed,accuracy\n5,1,0.58933\n5,2,0.564\n5,3,0.63333\n10,1,0.68667\n10,2,0.67867\n10,3,0.65333\n20,1,0.68\n20,2,0.67867\n20,3,0.716\n50,1,0.716\n50,2,0.69733\n50,3,0.71467\n100,1,0.72667\n100,2,0.72933\n100,3,0.728\n\"\"\"\ndf = pd.read_csv(io.StringIO(DATA))\n\ndef plot_learning(df):\n    g = df.groupby(\"labels_per_class\")[\"accuracy\"]\n    fig, ax = plt.subplots(figsize=(6.4, 3.4))\n    ax.scatter(df.labels_per_class, df.accuracy, color=\"#9aa5b1\", s=14, label=\"each run\")\n    ax.plot(g.mean().index, g.mean(), \"o-\", color=\"#1b7837\", label=\"mean of 3 runs\")\n    ax.set_xscale(\"log\"); ax.set_xticks([5, 10, 20, 50, 100], [5, 10, 20, 50, 100])\n    ax.set_xlabel(\"Training labels per class (Bandung)\")\n    ax.set_ylabel(\"Agreement with WorldCover (Garut)\")\n    ax.set_title(\"T1: the curve flattens early; where it flattens is the thesis\",\n                 loc=\"left\", fontsize=10)\n    ax.legend(frameon=False, fontsize=8)\n    return fig\n\nplot_learning(df)\nplt.show()\n"
 },
