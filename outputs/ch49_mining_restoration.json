nce,,2020,1\n0.76109,reference,,2020,1\n0.82377,reference,,2020,1\n0.71767,reference,,2021,1\n0.84166,reference,,2021,1\n0.74734,reference,,2021,1\n0.82265,reference,,2021,1\n0.80239,reference,,2021,1\n0.81542,reference,,2021,1\n0.75893,reference,,2021,1\n0.73363,reference,,2021,1\n0.82455,reference,,2021,1\n0.80586,reference,,2021,1\n0.88317,reference,,2021,1\n0.81272,reference,,2022,1\n0.78802,reference,,2022,1\n0.74607,reference,,2022,1\n0.76903,reference,,2022,1\n0.79111,reference,,2022,1\n0.76781,reference,,2022,1\n0.8433,reference,,2022,1\n0.83903,reference,,2022,1\n0.72424,reference,,2023,1\n0.77851,reference,,2023,1\n0.80587,reference,,2023,1\n0.78734,reference,,2023,1\n0.84119,reference,,2023,1\n0.83582,reference,,2023,1\n0.85122,reference,,2023,1\n0.82325,reference,,2023,1\n\"\"\"\ndf = pd.read_csv(io.StringIO(DATA))\n\ndef plot_trajectory(df):\n    m = df[df.kind == \"mined\"].copy()\n    m[\"since\"] = m.year - m.mined_year\n    g = m[(m.since >= -5) & (m.since <= 20)].groupby(\"since\").ndvi\n    ref = df[df.kind == \"reference\"].groupby(\"year\").ndvi.median().median()\n    fig, ax = plt.subplots(figsize=(8, 3.6))\n    ax.fill_between(g.median().index, g.quantile(0.25), g.quantile(0.75), color=\"#e08214\",\n                    alpha=0.25, label=\"middle half of mined pixels\")\n    ax.plot(g.median().index, g.median(), \"o-\", color=\"#e08214\", ms=3, label=\"median, mined 2000-2008\")\n    ax.axhline(ref, color=\"#1b7837\", ls=\"--\", label=f\"undisturbed reference ({ref:.2f})\")\n    ax.axvline(0, color=\"#1f2933\", lw=0.8)\n    ax.set_xlabel(\"Years since the land was laid bare\")\n    ax.set_ylabel(\"Annual median NDVI\")\n    ax.set_title(\"Greenness after tin mining, against land never mined\", loc=\"left\",\n                 fontsize=10)\n    ax.legend(frameon=False, fontsize=8)\n    return fig\n\nplot_trajectory(df)\nplt.show()\n"
