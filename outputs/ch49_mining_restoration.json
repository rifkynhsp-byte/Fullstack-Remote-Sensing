,1994,1\n0.58196,reference,,1994,1\n0.65531,reference,,1994,1\n0.77283,reference,,1994,1\n0.75479,reference,,1994,1\n0.68582,reference,,1994,1\n0.71311,reference,,1994,1\n0.6933,reference,,1994,1\n0.58992,reference,,1994,1\n0.70185,reference,,1994,1\n0.81583,reference,,1994,1\n0.66719,reference,,1994,1\n0.69689,reference,,1994,1\n0.68561,reference,,1994,1\n0.70283,reference,,1994,1\n0.72997,reference,,1994,1\n0.76383,reference,,1994,1\n0.73641,reference,,1994,1\n0.63788,reference,,1994,1\n0.68553,reference,,1994,1\n0.75732,reference,,1994,1\n0.71325,reference,,1994,1\n0.7302,reference,,1994,1\n0.80184,reference,,1995,1\n\"\"\"\ndf = pd.read_csv(io.StringIO(DATA))\n\ndef plot_trajectory(df):\n    m = df[df.kind == \"mined\"].copy()\n    m[\"since\"] = m.year - m.mined_year\n    g = m[(m.since >= -5) & (m.since <= 20)].groupby(\"since\").ndvi\n    ref = df[df.kind == \"reference\"].groupby(\"year\").ndvi.median().median()\n    fig, ax = plt.subplots(figsize=(8, 3.6))\n    ax.fill_between(g.median().index, g.quantile(0.25), g.quantile(0.75), color=\"#e08214\",\n                    alpha=0.25, label=\"middle half of mined pixels\")\n    ax.plot(g.median().index, g.median(), \"o-\", color=\"#e08214\", ms=3, label=\"median, mined 2000-2008\")\n    ax.axhline(ref, color=\"#1b7837\", ls=\"--\", label=f\"undisturbed reference ({ref:.2f})\")\n    ax.axvline(0, color=\"#1f2933\", lw=0.8)\n    ax.set_xlabel(\"Years since the land was laid bare\")\n    ax.set_ylabel(\"Annual median NDVI\")\n    ax.set_title(\"Greenness after tin mining, against land never mined\", loc=\"left\",\n                 fontsize=10)\n    ax.legend(frameon=False, fontsize=8)\n    return fig\n\nplot_trajectory(df)\nplt.show()\n"
