percentile (shading), one panel per month, 2014–2023. \"\n            \"The same axes in every panel let the eye compare panels without reading numbers.\", top=0.82)\n    fig.subplots_adjust(hspace=0.3, wspace=0.08)\n    return fig\n\nplot_diurnal(df)\nplt.show()\n"
