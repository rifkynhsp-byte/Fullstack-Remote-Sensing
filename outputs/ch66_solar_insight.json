  "name": "ch66-yield",
  "kind": "chart",
  "caption": "Insight 4. Monthly yield of a 1 kWp PV system and its year-to-year range.",
  "image": "images/real/ch66-yield.png",
  "live": "import io\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nDATA = \"\"\"site,month,mean,min,max\nKupang,1,113.15,92.362,133.15\nKupang,2,104.75,85.872,117.23\nKupang,3,128.19,114.71,139.22\nKupang,4,132.29,121.43,144.25\nKupang,5,136.13,119.08,143.8\nKupang,6,126.81,115.21,133.46\nKupang,7,137.41,125.73,148.1\nKupang,8,151,139.2,157.39\nKupang,9,155.35,137.73,165.75\nKupang,10,157.26,137.52,170.47\nKupang,11,136.11,112.49,150.8\nKupang,12,117.74,110.1,138.51\nBandung,1,93.101,74.767,103.92\nBandung,2,84.052,70.978,95.961\nBandung,3,103.78,94.651,111.16\nBandung,4,106.01,95.626,115.62\nBandung,5,116.84,98.744,130.47\nBandung,6,111.94,101.21,126.64\nBandung,7,123.86,111.14,136.04\nBandung,8,133.52,124.6,144.1\nBandung,9,130.71,105.68,145.46\nBandung,10,121.71,89.809,147.2\nBandung,11,98.99,81.464,119.84\nBandung,12,93.428,81.887,104.14\n\"\"\"\ndf = pd.read_csv(io.StringIO(DATA))\n\ndef plot_yield(df):\n    fig, ax = plt.subplots(figsize=(10, 4.2))\n    w = 0.38\n    for i, (site, c) in enumerate(zip(SITES, [\"#e6550d\", \"#3182bd\"])):\n        s = df[df.site == site]\n        x = s.month + (i - 0.5) * w\n        ax.bar(x, s[\"mean\"], width=w, color=c, alpha=0.85, label=f\"{site} (annual {s['mean'].sum():,.0f} kWh/kWp)\")\n        ax.errorbar(x, s[\"mean\"], yerr=[s[\"mean\"] - s[\"min\"], s[\"max\"] - s[\"mean\"]], fmt=\"none\", ecolor=\"#333\", lw=0.8, capsize=2)\n    ax.set_xticks(range(1, 13), [\"J\", \"F\", \"M\", \"A\", \"M\", \"J\", \"J\", \"A\", \"S\", \"O\", \"N\", \"D\"])\n    ax.set_ylabel(\"PV yield (kWh per kWp per month)\"); ax.legend(fontsize=8, loc=\"lower right\")\n    insight(fig, \"Insight 4: Kupang out-yields Bandung in every month, by the most in October and November\",\n            \"Mean monthly yield of a 1 kWp system (10° tilt towards the equator, 14 % losses); whiskers show the lowest \"\n            \"and highest year, 2014–2023.\")\n    return fig\n\nplot_yield(df)\nplt.show()\n"
 },
