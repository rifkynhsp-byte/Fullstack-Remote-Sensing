ale(\"symlog\")\n    ax.set_xlabel(\"Entropy (3 × 3 window)\")\n    ax.set_ylabel(\"Contrast (symlog)\")\n    ax.set_title(\"Entropy against contrast, by class\", loc=\"left\")\n    ax.legend(frameon=False, fontsize=7, markerscale=2)\n    return fig\n\nplot_texture_separability(df)\nplt.show()\n"
